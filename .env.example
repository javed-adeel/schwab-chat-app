# Copy to .env. Everything is optional: with no API key the app runs in
# "extractive" mode (deterministic, no LLM) so it works fully offline.

# Set a key for ONE (or more) providers to enable synthesized, cited summaries.

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# NEWSCHAT_ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini (GOOGLE_API_KEY also works)
GEMINI_API_KEY=
# NEWSCHAT_GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (one key, many vendors' models; model is an OpenRouter slug)
OPENROUTER_API_KEY=
# NEWSCHAT_OPENROUTER_MODEL=anthropic/claude-sonnet-5

# auto | anthropic | gemini | openrouter | extractive
# auto = first provider with a key, in the order anthropic, gemini, openrouter.
# Naming a provider explicitly requires its key (startup fails otherwise).
# NEWSCHAT_LLM_PROVIDER=auto

# NEWSCHAT_DATA_PATH=data/stock_news.json
# NEWSCHAT_LOG_LEVEL=INFO
# NEWSCHAT_LOG_JSON=false
# NEWSCHAT_PORT=8000
